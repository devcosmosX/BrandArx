# ─────────────────────────────────────────────────────────────────────────────
# BrandArx — Frontend Environment Variables (Vite)
# Copy this file to .env and fill in the values.
# All VITE_ prefixed variables are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── API Base URL ──────────────────────────────────────────────────────────────
# Leave EMPTY in both dev and production.
# Express (PORT=5000) is the single entry point:
#   - In dev: it reverse-proxies everything non-API to Vite (:8080) automatically.
#   - In prod: it serves the built SPA from dist/ directly.
# The axios client in src/services/api.ts already falls back to '' (same-origin)
# when this variable is not set, so API calls go to the same host:port the user
# opened — no CORS, no port juggling required.
VITE_API_URL=

# ── Google OAuth Client ID ────────────────────────────────────────────────────
# Must match the GOOGLE_CLIENT_ID in server/.env
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Cashfree JS SDK mode ──────────────────────────────────────────────────────
# Must match CASHFREE_ENV in server/.env
# sandbox  — use Cashfree TEST credentials (no real money)
# production — use Cashfree LIVE credentials (real payments)
VITE_CASHFREE_ENV=sandbox
