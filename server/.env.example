# ─────────────────────────────────────────────────────────────────────────────
# BrandArx — Backend Environment Variables
# Copy this file to server/.env and fill in the values before running.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development     # development | production

# Express is the single entry point. Open http://localhost:5000 in the browser.
PORT=5000

# Vite's dev server port. @lovable.dev/vite-tanstack-config locks this to 8080
# with strictPort=true — do not change this value.
FRONTEND_PORT=8080

# ── Frontend URL (used in email links and Cashfree return_url) ────────────────
# Dev:        http://localhost:5000   (Express reverse-proxies Vite internally)
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/brandarx

# ── JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=replace_with_64_char_random_hex_string
REFRESH_TOKEN_SECRET=replace_with_different_64_char_random_hex_string
JWT_2FA_SECRET=replace_with_another_64_char_random_hex_string

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
# Leave blank to use console-log mock (useful during local dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password       # Use an App Password, not your account password
SMTP_FROM="BrandArx <noreply@brandarx.com>"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URIs to add:
#   http://localhost:5000/auth   (dev — browser opens Express, which proxies to Vite)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Cashfree Payments ─────────────────────────────────────────────────────────
# Dashboard: https://merchant.cashfree.com → Developers → API Keys
# Use TEST keys with CASHFREE_ENV=sandbox; LIVE keys with CASHFREE_ENV=production
CASHFREE_ENV=sandbox           # sandbox | production
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Cashfree webhook endpoint (must be publicly reachable — use ngrok in dev)
# e.g. WEBHOOK_URL=https://abc123.ngrok.io
WEBHOOK_URL=
